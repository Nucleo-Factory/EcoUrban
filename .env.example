# Proveedor de correo que usará el formulario (ej: emailjs, resend, brevo)
MAIL_PROVIDER=

# Endpoint público o función backend que procesará el formulario
MAIL_API_URL=

# Identificadores públicos del proveedor, si corresponde
MAIL_PUBLIC_KEY=
MAIL_SERVICE_ID=
MAIL_TEMPLATE_ID=

# Dirección que recibirá las solicitudes
MAIL_TO_EMAIL=

# Nunca agregues aquí API keys privadas, contraseñas o tokens secretos.
# Las credenciales privadas deben vivir en el backend o en las variables
# protegidas del servidor de despliegue.
